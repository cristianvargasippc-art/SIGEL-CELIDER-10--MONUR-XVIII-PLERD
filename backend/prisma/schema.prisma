generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Comision {
  id        Int        @id @default(autoincrement())
  nombre    String     @db.VarChar(255)
  eventoId  Int?       @map("evento_id")
  createdAt DateTime   @default(now()) @map("created_at")
  evento    Evento?    @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  users     User[]
  delegados Delegado[]
  modoAsignacion ModoAsignacion @default(individual) @map("modo_asignacion")

  @@unique([nombre, eventoId])
  @@index([eventoId])
  @@map("comisiones")
}

model Distrito {
  id        Int      @id @default(autoincrement())
  codigo    String   @unique @db.VarChar(10)
  nombre    String   @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at")
  users     User[]
  eventos   Evento[]

  @@map("distritos")
}

model Evento {
  id          Int          @id @default(autoincrement())
  nombre      String       @db.VarChar(180)
  fecha       DateTime?
  distritoId  Int          @map("distrito_id")
  estado      EstadoEvento @default(borrador)
  createdById Int?         @map("created_by_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  distrito    Distrito     @relation(fields: [distritoId], references: [id])
  createdBy   User?        @relation("EventosCreados", fields: [createdById], references: [id])
  comisiones  Comision[]
  delegados   Delegado[]

  @@index([distritoId])
  @@map("eventos")
}

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique @db.VarChar(255)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  role         Role
  comisionId   Int?       @map("comision_id")
  distritoId   Int?       @map("distrito_id")
  ultimoLogin  DateTime?  @map("ultimo_login")
  estado       EstadoUser @default(activo)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")
  comision     Comision?  @relation(fields: [comisionId], references: [id])
  distrito     Distrito?  @relation(fields: [distritoId], references: [id])
  audits       Audit[]
  eventosCreados Evento[] @relation("EventosCreados")

  @@index([email])
  @@index([role])
  @@index([distritoId])
  @@map("users")
}

model Delegado {
  id           Int           @id @default(autoincrement())
  nombre       String        @db.VarChar(255)
  designacion  String?       @db.VarChar(255)
  apellido     String?       @db.VarChar(120)
  eventoId     Int?          @map("evento_id")
  comisionId   Int?          @map("comision_id")
  asistencia   PresenteEstado @default(presente_votando)
  avanzaEtapa  Boolean       @default(false) @map("avanza_etapa")
  asignacionGrupo String?    @map("asignacion_grupo") @db.VarChar(80)
  createdAt    DateTime      @default(now()) @map("created_at")
  evento       Evento?       @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  comision     Comision?     @relation(fields: [comisionId], references: [id])
  calificacion Calificacion?

  @@index([eventoId])
  @@index([comisionId])
  @@index([nombre])
  @@map("delegados")
}

model Calificacion {
  id              Int             @id @default(autoincrement())
  delegadoId      Int             @unique @map("delegado_id")
  oratoria        Int?
  argumentacion   Int?
  negociacion     Int?
  liderazgo       Int?
  redaccion       Int?
  ponderada       Float           @default(0)
  presenteEstado  PresenteEstado? @map("presente_estado")
  pasaMinumeXvii  Boolean?        @map("pasa_minume_xvii")
  mencion         String?         @db.Text
  feedback        String?         @db.Text
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  delegado        Delegado        @relation(fields: [delegadoId], references: [id])

  @@index([delegadoId])
  @@index([ponderada])
  @@map("calificaciones")
}

model Audit {
  id         Int      @id @default(autoincrement())
  userId     Int?     @map("user_id")
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(100)
  entityId   Int?     @map("entity_id")
  changes    Json?
  createdAt  DateTime @default(now()) @map("created_at")
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@map("audits")
}

model Config {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(255)
  value     String?  @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("config")
}

enum Role {
  superadmin
  regional
  distrito
  admin

  @@map("role")
}

enum EstadoUser {
  activo
  inactivo

  @@map("estado_user")
}

enum PresenteEstado {
  presente_votando
  ausente

  @@map("presente_estado")
}

enum EstadoEvento {
  borrador
  activo
  cerrado

  @@map("estado_evento")
}

enum ModoAsignacion {
  individual
  duplas

  @@map("modo_asignacion")
}
