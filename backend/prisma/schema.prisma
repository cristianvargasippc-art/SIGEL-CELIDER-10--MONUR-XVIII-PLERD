generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl= env("DIRECT_URL")
}

model Comision {
  id        Int        @id @default(autoincrement())
  nombre    String
  eventoId  Int?       @map("evento_id")
  createdAt DateTime   @default(now()) @map("created_at")
  evento    Evento?    @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  users     User[]
  delegados Delegado[]
  modoAsignacion String @default("individual") @map("modo_asignacion")

  @@unique([nombre, eventoId])
  @@index([eventoId])
  @@map("comisiones")
}

model Distrito {
  id        Int      @id @default(autoincrement())
  codigo    String   @unique
  nombre    String
  createdAt DateTime @default(now()) @map("created_at")
  users     User[]
  eventos   Evento[]

  @@map("distritos")
}

model Evento {
  id          Int          @id @default(autoincrement())
  nombre      String
  fecha       DateTime?
  distritoId  Int          @map("distrito_id")
  estado      String       @default("borrador")
  createdById Int?         @map("created_by_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  distrito    Distrito     @relation(fields: [distritoId], references: [id])
  createdBy   User?        @relation("EventosCreados", fields: [createdById], references: [id])
  comisiones  Comision[]
  delegados   Delegado[]

  @@index([distritoId])
  @@map("eventos")
}

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  passwordHash String     @map("password_hash")
  role         String
  comisionId   Int?       @map("comision_id")
  distritoId   Int?       @map("distrito_id")
  ultimoLogin  DateTime?  @map("ultimo_login")
  estado       String     @default("activo")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")
  comision     Comision?  @relation(fields: [comisionId], references: [id])
  distrito     Distrito?  @relation(fields: [distritoId], references: [id])
  audits       Audit[]
  eventosCreados Evento[] @relation("EventosCreados")
  encuestas    EncuestaSatisfaccion[]

  @@index([email])
  @@index([role])
  @@index([distritoId])
  @@map("users")
}

model Delegado {
  id           Int           @id @default(autoincrement())
  nombre       String
  designacion  String?
  apellido     String?
  eventoId     Int?          @map("evento_id")
  comisionId   Int?          @map("comision_id")
  asistencia   String        @default("presente_votando")
  avanzaEtapa  Boolean       @default(false) @map("avanza_etapa")
  asignacionGrupo String?    @map("asignacion_grupo")
  createdAt    DateTime      @default(now()) @map("created_at")
  evento       Evento?       @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  comision     Comision?     @relation(fields: [comisionId], references: [id])
  calificacion Calificacion?

  @@index([eventoId])
  @@index([comisionId])
  @@index([nombre])
  @@map("delegados")
}

model Calificacion {
  id              Int             @id @default(autoincrement())
  delegadoId      Int             @unique @map("delegado_id")
  oratoria        Float?
  argumentacion   Float?
  negociacion     Float?
  liderazgo       Float?
  redaccion       Float?
  ponderada       Float           @default(0)
  presenteEstado  String?         @map("presente_estado")
  pasaMinumeXvii  Boolean?        @map("pasa_minume_xvii")
  mencion         String?
  feedback        String?
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  delegado        Delegado        @relation(fields: [delegadoId], references: [id])

  @@index([delegadoId])
  @@index([ponderada])
  @@map("calificaciones")
}

model Audit {
  id         Int      @id @default(autoincrement())
  userId     Int?     @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   Int?     @map("entity_id")
  changes    Json?
  createdAt  DateTime @default(now()) @map("created_at")
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@map("audits")
}

model Config {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String?
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("config")
}

model EncuestaSatisfaccion {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  puntuacion  Int
  respuestas  Json
  comentario  String?
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("encuestas_satisfaccion")
}
